rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Primitives ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMonthKey(monthKey) {
      return monthKey is string && monthKey.size() == 7 && monthKey.matches('^[0-9]{4}-[0-9]{2}$');
    }

    function isValidDateString(dateStr) {
      return dateStr is string && dateStr.size() == 10 && dateStr.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // --- Validation Blueprints ---
    function isValidUserLedger(data, userId) {
      return data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.email is string
        && data.email.size() >= 3 && data.email.size() <= 254
        && data.photoURL is string
        && data.photoURL.size() <= 512
        && data.currency is string
        && data.currency == 'THB'
        && (data.defaultMonthlyBudget is int || data.defaultMonthlyBudget is float)
        && data.defaultMonthlyBudget >= 0
        && data.defaultMonthlyBudget <= 1000000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data, userId) {
      return data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.type is string
        && (data.type == 'income' || data.type == 'expense')
        && (data.amount is int || data.amount is float)
        && data.amount > 0
        && data.amount <= 1000000000
        && data.category is string
        && data.category.size() >= 1 && data.category.size() <= 50
        && data.title is string
        && data.title.size() >= 1 && data.title.size() <= 120
        && data.note is string
        && data.note.size() <= 300
        && isValidDateString(data.date)
        && isValidMonthKey(data.monthKey)
        && data.date.matches('^' + data.monthKey + '-[0-9]{2}$')
        && data.paymentMethod is string
        && data.paymentMethod.size() >= 1 && data.paymentMethod.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMonthlyBudget(data, userId, monthKey) {
      return data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && isValidMonthKey(data.monthKey)
        && data.monthKey == monthKey
        && (data.limitAmount is int || data.limitAmount is float)
        && data.limitAmount >= 0
        && data.limitAmount <= 1000000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection: 69319100011DB (User Ledger Root) ---
    match /69319100011DB/{userId} {
      // PII Isolation: strictly single-document get by verified owner; list is forbidden
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && incoming().keys().hasAll(['uid', 'displayName', 'email', 'photoURL', 'currency', 'defaultMonthlyBudget', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'currency', 'defaultMonthlyBudget', 'createdAt', 'updatedAt'])
        && isValidUserLedger(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserLedger(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['defaultMonthlyBudget', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'defaultMonthlyBudget', 'updatedAt'])
        );

      allow delete: if false;

      // --- Subcollection: transactions ---
      match /transactions/{transactionId} {
        allow get: if isValidId(userId)
          && isValidId(transactionId)
          && isOwner(userId)
          && existing().userId == request.auth.uid;

        // Secure list query: no get()/exists() in list; resource.data checked directly
        allow list: if isValidId(userId)
          && isOwner(userId)
          && resource.data.userId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(transactionId)
          && isOwner(userId)
          && incoming().keys().hasAll(['userId', 'type', 'amount', 'category', 'title', 'note', 'date', 'monthKey', 'paymentMethod', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['userId', 'type', 'amount', 'category', 'title', 'note', 'date', 'monthKey', 'paymentMethod', 'createdAt', 'updatedAt'])
          && isValidTransaction(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/69319100011DB/$(userId))
          && get(/databases/$(database)/documents/69319100011DB/$(userId)).data.uid == request.auth.uid;

        allow update: if isValidId(userId)
          && isValidId(transactionId)
          && isOwner(userId)
          && isValidTransaction(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['type', 'amount', 'category', 'title', 'note', 'date', 'monthKey', 'paymentMethod', 'updatedAt'])
          && exists(/databases/$(database)/documents/69319100011DB/$(userId))
          && get(/databases/$(database)/documents/69319100011DB/$(userId)).data.uid == request.auth.uid;

        allow delete: if isValidId(userId)
          && isValidId(transactionId)
          && isOwner(userId)
          && existing().userId == request.auth.uid;
      }

      // --- Subcollection: budgets ---
      match /budgets/{monthKey} {
        allow get: if isValidId(userId)
          && isValidMonthKey(monthKey)
          && isOwner(userId)
          && existing().userId == request.auth.uid;

        allow list: if isValidId(userId)
          && isOwner(userId)
          && resource.data.userId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidMonthKey(monthKey)
          && isOwner(userId)
          && incoming().keys().hasAll(['userId', 'monthKey', 'limitAmount', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['userId', 'monthKey', 'limitAmount', 'createdAt', 'updatedAt'])
          && isValidMonthlyBudget(incoming(), userId, monthKey)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/69319100011DB/$(userId))
          && get(/databases/$(database)/documents/69319100011DB/$(userId)).data.uid == request.auth.uid;

        allow update: if isValidId(userId)
          && isValidMonthKey(monthKey)
          && isOwner(userId)
          && isValidMonthlyBudget(incoming(), userId, monthKey)
          && incoming().userId == existing().userId
          && incoming().monthKey == existing().monthKey
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['limitAmount', 'updatedAt'])
          && exists(/databases/$(database)/documents/69319100011DB/$(userId))
          && get(/databases/$(database)/documents/69319100011DB/$(userId)).data.uid == request.auth.uid;

        allow delete: if isValidId(userId)
          && isValidMonthKey(monthKey)
          && isOwner(userId)
          && existing().userId == request.auth.uid;
      }
    }
  }
}
